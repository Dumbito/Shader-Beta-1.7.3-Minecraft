{
  "schemaVersion": 1,
  "id": "beta173_climate_bridge",
  "version": "${version}",
  "name": "Beta173 Climate Bridge",
  "description": "Optionally supplies the original Beta 1.7.3 climate color to Iris when raw world seed access is available.",
  "environment": "*",
  "authors": [
    "Beta173 Lighting contributors"
  ],
  "contact": {
    "homepage": "https://github.com/Dumbito/Shader-Beta-1.7.3-Minecraft",
    "sources": "https://github.com/Dumbito/Shader-Beta-1.7.3-Minecraft"
  },
  "entrypoints": {
    "main": [
      "dev.beta173.climatebridge.Beta173ClimateBridge"
    ],
    "client": [
      "dev.beta173.climatebridge.Beta173ClimateBridgeClient"
    ]
  },
  "mixins": [
    {
      "config": "beta173-climate-bridge.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "iris": ">=1.11.6"
  }
}
